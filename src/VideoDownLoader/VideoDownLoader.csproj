<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VideoDownLoader</RootNamespace>
    <Version>1.0.0</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">development</SourceRevisionId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CommitSha" Value="$(SourceRevisionId)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
</Project>
