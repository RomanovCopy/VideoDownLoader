<Window x:Class="VideoDownLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoDownLoader"
        Width="860"
        Height="720"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="VideoDownLoader" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Простой загрузчик доступных HLS/DASH-потоков без работы с DRM." />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Margin="0,0,0,14"
                Background="{StaticResource PanelBrush}"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,7" Text="Ссылка на видео или прямой эфир" />
                <TextBox x:Name="UrlTextBox"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         MinHeight="38"
                         VerticalContentAlignment="Center"
                         ToolTip="Например: ссылка YouTube или прямой .m3u8/.mpd URL" />

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15,0,7" Text="Папка для сохранения" />
                <TextBox x:Name="OutputDirectoryTextBox"
                         Grid.Row="3"
                         Grid.Column="0"
                         Margin="0,0,10,0"
                         MinHeight="38"
                         VerticalContentAlignment="Center" />
                <Button x:Name="BrowseButton"
                        Grid.Row="3"
                        Grid.Column="1"
                        Click="BrowseButton_Click"
                        Content="Обзор…" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="18"
                Margin="0,0,0,14"
                Background="{StaticResource PanelBrush}"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,7" Text="Качество" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,7" Text="Контейнер" />

                <ComboBox x:Name="QualityComboBox" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" SelectedIndex="0">
                    <ComboBoxItem Content="Лучшее доступное" />
                    <ComboBoxItem Content="До 1080p" />
                    <ComboBoxItem Content="До 720p" />
                    <ComboBoxItem Content="Только аудио (MP3)" />
                </ComboBox>
                <ComboBox x:Name="ContainerComboBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="MKV" />
                    <ComboBoxItem Content="MP4" />
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="PlaylistCheckBox" Margin="0,0,20,0" Content="Загрузить плейлист" />
                <CheckBox x:Name="LiveFromStartCheckBox"
                          Content="Эфир с начала DVR"
                          ToolTip="Работает только там, где источник предоставляет предыдущие сегменты эфира." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="InstallToolsButton"
                        Margin="0,0,10,0"
                        Click="InstallToolsButton_Click"
                        Content="Установить инструменты" />
                <Button x:Name="DownloadButton"
                        Width="120"
                        Margin="0,0,10,0"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#082F49"
                        FontWeight="SemiBold"
                        Click="DownloadButton_Click"
                        Content="Загрузить" />
                <Button x:Name="CancelButton"
                        Width="90"
                        IsEnabled="False"
                        Click="CancelButton_Click"
                        Content="Отмена" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Padding="14"
                Background="{StaticResource PanelBrush}"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusTextBlock" FontWeight="SemiBold" Text="Проверка инструментов…" />
                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Row="1"
                             Height="8"
                             Margin="0,10,0,12"
                             Maximum="100" />
                <TextBox x:Name="LogTextBox"
                         Grid.Row="2"
                         Padding="8"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,14,0,0" Orientation="Horizontal">
            <TextBlock x:Name="ToolsStatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <Button x:Name="OpenFolderButton"
                    Margin="14,0,0,0"
                    Padding="10,5"
                    Click="OpenFolderButton_Click"
                    Content="Открыть папку" />
        </StackPanel>
    </Grid>
</Window>
