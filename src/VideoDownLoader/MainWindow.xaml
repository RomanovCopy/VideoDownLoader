<Window x:Class="VideoDownLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:VideoDownLoader.Behaviors"
        Title="VideoDownLoader"
        Width="1180"
        Height="820"
        MinWidth="960"
        MinHeight="680"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        behaviors:MainWindowBehavior.IsEnabled="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="SemiBold" Text="VideoDownLoader" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                           Text="Анализ, очередь и загрузка доступного видео без обхода DRM." />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="ToolsStatusTextBlock" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}" />
                <Button x:Name="InstallToolsButton" Margin="0,7,0,0"
                        behaviors:MainWindowBehavior.Action="InstallToolsButton_Click"
                        Content="Установить инструменты" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="16" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" Text="Ссылка на видео, плейлист или эфир" />
                            <TextBox x:Name="UrlTextBox" MinHeight="40" VerticalContentAlignment="Center"
                                     ToolTip="HTTP/HTTPS-ссылка на страницу, .m3u8 или .mpd" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PasteButton"
                                        behaviors:MainWindowBehavior.Action="PasteButton_Click"
                                        Content="Вставить" />
                                <Button x:Name="ClearUrlButton" Grid.Column="1" Margin="8,0,0,0"
                                        behaviors:MainWindowBehavior.Action="ClearUrlButton_Click"
                                        Content="Очистить адрес" />
                                <Button x:Name="AnalyzeButton" Grid.Column="3"
                                        Background="{StaticResource AccentBrush}" Foreground="#082F49"
                                        FontWeight="SemiBold"
                                        behaviors:MainWindowBehavior.Action="AnalyzeButton_Click"
                                        Content="Проверить ссылку" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AnalysisPanel" Margin="0,12,0,0" Padding="14"
                            Background="{StaticResource PanelBrush}" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Width="104" Height="68" Background="#111827" CornerRadius="6" ClipToBounds="True">
                                        <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
                                    </Border>
                                    <Button x:Name="ClearThumbnailButton" Width="104" Margin="0,6,0,0" Padding="5,3"
                                            IsEnabled="False"
                                            behaviors:MainWindowBehavior.Action="ClearThumbnailButton_Click"
                                            Content="Убрать обложку" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock x:Name="AnalysisTitleTextBlock" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="AnalysisDetailsTextBlock" Margin="0,5,0,0"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="DrmWarningBorder" Margin="0,12,0,0" Padding="10"
                                    Background="#4C1D1D" CornerRadius="6" Visibility="Collapsed">
                                <TextBlock x:Name="DrmWarningTextBlock" Foreground="#FCA5A5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="16" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" Text="Папка для сохранения" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputDirectoryTextBox" MinHeight="38" VerticalContentAlignment="Center" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0"
                                        behaviors:MainWindowBehavior.Action="BrowseButton_Click" Content="Обзор…" />
                            </Grid>

                            <TextBlock Margin="0,14,0,7" Text="Формат из анализа" />
                            <ComboBox x:Name="FormatComboBox" DisplayMemberPath="DisplayName"
                                      behaviors:MainWindowBehavior.Action="FormatComboBox_SelectionChanged" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Margin="0,0,0,6" Text="Качество" />
                                    <ComboBox x:Name="QualityComboBox"
                                              behaviors:MainWindowBehavior.Action="QualityComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Лучшее" />
                                        <ComboBoxItem Content="До 1080p" />
                                        <ComboBoxItem Content="До 720p" />
                                        <ComboBoxItem Content="Только аудио" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Margin="0,0,0,6" Text="Контейнер" />
                                    <ComboBox x:Name="ContainerComboBox">
                                        <ComboBoxItem Content="MKV" />
                                        <ComboBoxItem Content="MP4" />
                                        <ComboBoxItem Content="WebM" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Margin="0,0,0,6" Text="Аудио" />
                                    <ComboBox x:Name="AudioFormatComboBox">
                                        <ComboBoxItem Content="MP3" />
                                        <ComboBoxItem Content="M4A" />
                                        <ComboBoxItem Content="Opus" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,12,0,0" Padding="10" Background="#111827" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Устойчивость YouTube" />
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="Канал yt-dlp:" />
                                        <ComboBox x:Name="YtDlpChannelComboBox" Grid.Column="1" Margin="8,0,0,0"
                                                  behaviors:MainWindowBehavior.Action="YtDlpChannelComboBox_SelectionChanged"
                                                  ToolTip="Nightly быстрее получает исправления YouTube; stable консервативнее.">
                                            <ComboBoxItem Content="Nightly (рекомендуется)" />
                                            <ComboBoxItem Content="Stable" />
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="AutoRepairYouTubeCheckBox" Margin="0,9,0,0"
                                              Content="Автоматически обновить компоненты и повторить один раз" />
                                    <CheckBox x:Name="PoTokenProviderCheckBox" Margin="0,9,0,0"
                                              behaviors:MainWindowBehavior.Action="PoTokenProviderCheckBox_Changed"
                                              Content="Использовать внешний PO Token provider" />
                                    <TextBox x:Name="PoTokenProviderUrlTextBox" Margin="0,7,0,0"
                                             IsEnabled="False" Text="http://127.0.0.1:4416"
                                             ToolTip="Адрес совместимого bgutil HTTP provider. Приложение не запускает сторонний сервер автоматически." />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PoTokenProviderStatusTextBlock" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" Text="Provider не проверен" />
                                        <Button x:Name="CheckPoTokenProviderButton" Grid.Column="1" Padding="8,3"
                                                IsEnabled="False"
                                                behaviors:MainWindowBehavior.Action="CheckPoTokenProviderButton_Click"
                                                Content="Проверить" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <CheckBox x:Name="PlaylistCheckBox" Margin="0,0,18,8" Content="Весь плейлист" />
                                <CheckBox x:Name="LiveFromStartCheckBox" Margin="0,0,18,8" Content="Эфир с начала DVR" />
                                <CheckBox x:Name="MetadataCheckBox" Margin="0,0,18,8" Content="Метаданные" />
                                <CheckBox x:Name="ThumbnailCheckBox" Margin="0,0,18,8" Content="Обложка" />
                                <CheckBox x:Name="SubtitlesCheckBox" Margin="0,0,18,8"
                                          behaviors:MainWindowBehavior.Action="SubtitlesCheckBox_Changed"
                                          Content="Субтитры" />
                            </WrapPanel>
                            <Grid x:Name="SubtitleOptionsGrid" Margin="0,4,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Языки:" />
                                <TextBox x:Name="SubtitleLanguagesTextBox" Grid.Column="1" Margin="8,0,0,0"
                                         ToolTip="Например: ru,en или all" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Cookies:" />
                                <ComboBox x:Name="CookieBrowserComboBox" Grid.Column="1" Margin="8,0,0,0"
                                          ToolTip="Cookies читаются yt-dlp напрямую из выбранного браузера и не сохраняются приложением.">
                                    <ComboBoxItem Content="Не использовать" />
                                    <ComboBoxItem Content="Chrome" />
                                    <ComboBoxItem Content="Edge" />
                                    <ComboBoxItem Content="Firefox" />
                                    <ComboBoxItem Content="Brave" />
                                </ComboBox>
                            </Grid>

                            <Button x:Name="AddToQueueButton" Margin="0,15,0,0" HorizontalAlignment="Stretch"
                                    Background="{StaticResource AccentBrush}" Foreground="#082F49"
                                    FontWeight="SemiBold" IsEnabled="False"
                                    behaviors:MainWindowBehavior.Action="AddToQueueButton_Click"
                                    Content="Добавить в очередь" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2" Background="{StaticResource PanelBrush}" BorderThickness="0">
                <TabItem Header="Очередь">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Задания" />
                            <Button x:Name="ClearQueueButton" Grid.Column="1" Margin="0,0,8,0" IsEnabled="False"
                                    behaviors:MainWindowBehavior.Action="ClearQueueButton_Click"
                                    ToolTip="Удалить все задания плейлиста из очереди"
                                    Content="Очистить" />
                            <Button x:Name="StartQueueButton" Grid.Column="2" Margin="0,0,8,0"
                                    behaviors:MainWindowBehavior.Action="StartQueueButton_Click"
                                    Content="Запустить очередь" />
                            <Button x:Name="CancelButton" Grid.Column="3" IsEnabled="False"
                                    behaviors:MainWindowBehavior.Action="CancelButton_Click" Content="Остановить" />
                        </Grid>
                        <ListView x:Name="QueueListView" Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Background="#111827" CornerRadius="7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Margin="0,0,6,0" Padding="8,3"
                                                        behaviors:MainWindowBehavior.Action="RetryQueueItem_Click"
                                                        Content="Повторить" />
                                                <Button Padding="8,3"
                                                        behaviors:MainWindowBehavior.Action="RemoveQueueItem_Click"
                                                        Content="Удалить" />
                                            </StackPanel>
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="7" Margin="0,10,0,7"
                                                         Maximum="100" Value="{Binding Progress}" />
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding StatusText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>
                <TabItem Header="Изображения">
                    <Grid Margin="14">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="*" />
                             <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Text="Извлечение изображений со страницы" />

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="Auto" />
                             </Grid.ColumnDefinitions>
                             <TextBox x:Name="WebsiteUrlTextBox" MinHeight="38"
                                      VerticalContentAlignment="Center"
                                      ToolTip="HTTP/HTTPS-ссылка на веб-страницу" />
                             <Button Grid.Column="1" Margin="8,0,0,0"
                                     behaviors:MainWindowBehavior.Action="PasteWebsiteUrlButton_Click"
                                     Content="Вставить" />
                             <Button x:Name="FavoriteWebsiteUrlButton" Grid.Column="2" Margin="8,0,0,0"
                                     behaviors:MainWindowBehavior.Action="FavoriteWebsiteUrlButton_Click"
                                     Content="★ Добавить"
                                     ToolTip="Сохранить текущий URL в избранном" />
                             <Button x:Name="ClearImageSearchButton" Grid.Column="3" Margin="8,0,0,0"
                                     behaviors:MainWindowBehavior.Action="ClearImageSearchButton_Click" Content="Очистить" />
                             <Button x:Name="AnalyzeImagesButton" Grid.Column="4" Margin="8,0,0,0"
                                     Background="{StaticResource AccentBrush}" Foreground="#082F49"
                                     FontWeight="SemiBold" behaviors:MainWindowBehavior.Action="AnalyzeImagesButton_Click"
                                     Content="Найти" />
                         </Grid>

                         <Grid Grid.Row="2" Margin="0,10,0,0">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="Auto" />
                             </Grid.ColumnDefinitions>
                             <TextBlock VerticalAlignment="Center" Text="Избранное:" />
                             <ComboBox x:Name="FavoriteWebsiteUrlsComboBox" Grid.Column="1" Margin="8,0,0,0"
                                       behaviors:MainWindowBehavior.Action="FavoriteWebsiteUrlsComboBox_SelectionChanged"
                                       ToolTip="Выберите сохранённый URL" />
                             <Button x:Name="RemoveFavoriteWebsiteUrlButton" Grid.Column="2" Margin="8,0,0,0"
                                     behaviors:MainWindowBehavior.Action="RemoveFavoriteWebsiteUrlButton_Click"
                                     Content="Удалить" />
                         </Grid>

                         <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Доступ:" />
                            <ComboBox x:Name="ImageAccessModeComboBox" Grid.Column="1" Margin="8,0,0,0"
                                      behaviors:MainWindowBehavior.Action="ImageAccessModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Без авторизации" />
                                <ComboBoxItem Content="Встроенный браузер" />
                            </ComboBox>
                            <Button x:Name="OpenAuthenticatedBrowserButton" Grid.Column="2" Margin="8,0,0,0"
                                    IsEnabled="False"
                                    behaviors:MainWindowBehavior.Action="OpenAuthenticatedBrowserButton_Click"
                                    Content="Открыть / войти" />
                            <TextBlock x:Name="ImageSessionStatusTextBlock" Grid.Column="3" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       Text="Публичная страница" TextTrimming="CharacterEllipsis" />
                        </Grid>

                         <Grid Grid.Row="4" Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Качество:" />
                            <ComboBox x:Name="ImageQualityComboBox" Grid.Column="1" Width="180" Margin="8,0,0,0"
                                      ToolTip="Иконки и изображения меньше выбранного размера исключаются">
                                <ComboBoxItem Content="От 600 × 300 px" />
                                <ComboBoxItem Content="От 1200 × 600 px" />
                                <ComboBoxItem Content="От 400 × 200 px" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Text="Вложенность:" />
                            <ComboBox x:Name="ImageScanDepthComboBox" Grid.Column="3" Width="54" Margin="7,0,0,0"
                                      ToolTip="Сколько уровней страниц открывать по ссылкам с превью">
                                <ComboBoxItem Content="0" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                            </ComboBox>
                            <TextBlock x:Name="ImagesSummaryTextBlock" Grid.Column="4" Margin="12,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       Text="Изображения ещё не искали" />
                            <Button Grid.Column="5" Padding="8,3"
                                    behaviors:MainWindowBehavior.Action="SelectAllImagesButton_Click"
                                    Content="Выбрать все" />
                            <Button Grid.Column="6" Margin="6,0,0,0" Padding="8,3"
                                    behaviors:MainWindowBehavior.Action="ClearImageSelectionButton_Click" Content="Снять" />
                        </Grid>

                         <ListView x:Name="WebsiteImagesListView" Grid.Row="5"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Background="#111827" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Margin="0,0,10,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      behaviors:MainWindowBehavior.Action="WebsiteImageSelection_Changed" />
                                            <Border Grid.Column="1" Width="104" Height="72"
                                                    Background="#0B1220" CornerRadius="5" ClipToBounds="True">
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="10,0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding QualityDescription}" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding Address}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Address}" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Padding="8,3" VerticalAlignment="Center"
                                                    behaviors:MainWindowBehavior.Action="OpenWebsiteImageButton_Click"
                                                    Content="Открыть" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                         <Grid Grid.Row="6" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                             <TextBox x:Name="ImageOutputDirectoryTextBox" MinHeight="38"
                                      VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    behaviors:MainWindowBehavior.Action="BrowseImageFolderButton_Click"
                                    Content="Обзор…" />
                             <Button x:Name="CancelImageOperationButton" Grid.Column="2" Margin="8,0,0,0"
                                     IsEnabled="False"
                                     behaviors:MainWindowBehavior.Action="CancelImageOperationButton_Click"
                                    Content="Отмена" />
                            <Button x:Name="SaveSelectedImagesButton" Grid.Column="3" Margin="8,0,0,0"
                                     Background="{StaticResource AccentBrush}" Foreground="#082F49"
                                     FontWeight="SemiBold" IsEnabled="False"
                                     behaviors:MainWindowBehavior.Action="SaveSelectedImagesButton_Click"
                                     Content="Сохранить выбранные" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="История">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Последние загрузки" />
                            <Button Grid.Column="1" behaviors:MainWindowBehavior.Action="ClearHistoryButton_Click"
                                    Content="Очистить" />
                        </Grid>
                        <ListView x:Name="HistoryListView" Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Background="#111827" CornerRadius="7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Margin="0,5,8,0" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Result}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Timestamp, StringFormat={}{0:g}}" />
                                            <StackPanel Grid.RowSpan="3" Grid.Column="1" Margin="10,0,0,0">
                                                <Button Margin="0,0,0,6" Padding="8,3"
                                                        behaviors:MainWindowBehavior.Action="OpenHistoryFolder_Click"
                                                        Content="Папка" />
                                                <Button Padding="8,3"
                                                        behaviors:MainWindowBehavior.Action="ReuseHistoryUrl_Click"
                                                        Content="Ссылка" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>
                <TabItem Header="Журнал">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button HorizontalAlignment="Right" Margin="0,0,0,8" Padding="9,4"
                                behaviors:MainWindowBehavior.Action="CopyDiagnosticsButton_Click"
                                Content="Копировать диагностику" />
                        <TextBox x:Name="LogTextBox" Grid.Row="1" Padding="10" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="GlobalProgressBar" Width="160" Height="7" Margin="0,0,12,0" Maximum="100" />
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Text="Готово." />
            </StackPanel>
            <Button Grid.Column="1" Padding="10,5"
                    behaviors:MainWindowBehavior.Action="OpenFolderButton_Click" Content="Открыть папку" />
        </Grid>
    </Grid>
</Window>
